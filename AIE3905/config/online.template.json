{
  "mode": "openai",
  "database": "../data/online.sqlite3",
  "max_attempts": 3,
  "query_wait_seconds": 8,
  "groups": [
    {
      "key": "lab",
      "enabled": true,
      "data_use_confirmed": true,
      "admins": [
        "owner"
      ],
      "confirmers": [
        "owner"
      ],
      "confirmation": "designated",
      "timezone": "Asia/Shanghai",
      "retention_days": 30,
      "processing_location": "填写实际服务商和区域；只用于完全虚构数据",
      "proactive": false,
      "report_time": ""
    }
  ],
  "web": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765,
    "tokens": [
      {
        "env": "GROUPBOT_ADMIN_TOKEN",
        "user": "owner",
        "groups": [
          "lab"
        ],
        "admin": true
      }
    ]
  },
  "models": {
    "understanding": {
      "base_url": "https://YOUR_PROVIDER_BASE_URL/v1",
      "model": "YOUR_MODEL_ID",
      "api_key_env": "GROUPBOT_MODEL_API_KEY",
      "allow_remote": true,
      "json_mode": true,
      "timeout": 40,
      "max_tokens": 1800
    },
    "answering": {
      "base_url": "https://YOUR_PROVIDER_BASE_URL/v1",
      "model": "YOUR_MODEL_ID",
      "api_key_env": "GROUPBOT_MODEL_API_KEY",
      "allow_remote": true,
      "json_mode": true,
      "timeout": 40,
      "max_tokens": 1800
    }
  }
}
