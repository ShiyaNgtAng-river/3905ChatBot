{
  "mode": "astrbot",
  "database": "../data/qq.sqlite3",
  "max_attempts": 3,
  "query_wait_seconds": 8,
  "dialogue": {
    "enabled": true,
    "frontend": "astrbot",
    "context_messages": 40,
    "fast_provider": "REPLACE_WITH_FAST_PROVIDER_ID",
    "deep_provider": "REPLACE_WITH_REASONING_PROVIDER_ID"
  },
  "memory": {
    "reading": true,
    "qa_list": "qa_list.json",
    "read_new_chars": 6000,
    "read_idle_minutes": 60,
    "read_min_minutes": 10,
    "consolidate_time": "04:00",
    "gate": true,
    "profiles": true
  },
  "groups": [
    {
      "key": "qq-pilot",
      "enabled": false,
      "data_use_confirmed": false,
      "admins": [
        "REPLACE_WITH_PLATFORM_USER_ID"
      ],
      "confirmers": [
        "REPLACE_WITH_PLATFORM_USER_ID"
      ],
      "confirmation": "designated",
      "timezone": "Asia/Shanghai",
      "retention_days": 30,
      "processing_location": "填写实际服务商和区域",
      "proactive": false,
      "report_time": "",
      "platform_id": "qq-pilot",
      "native_group_id": "REPLACE_WITH_PLATFORM_GROUP_ID"
    }
  ],
  "web": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765,
    "tokens": [
      {
        "env": "GROUPBOT_ADMIN_TOKEN",
        "user": "REPLACE_WITH_PLATFORM_USER_ID",
        "groups": [
          "qq-pilot"
        ],
        "admin": true
      }
    ]
  },
  "models": {
    "understanding": {
      "provider_id": "REPLACE_WITH_ASTRBOT_PROVIDER_ID"
    },
    "answering": {
      "provider_id": "REPLACE_WITH_ASTRBOT_PROVIDER_ID"
    },
    "consolidating": {
      "provider_id": "REPLACE_WITH_STRONGER_ASTRBOT_PROVIDER_ID"
    }
  }
}
